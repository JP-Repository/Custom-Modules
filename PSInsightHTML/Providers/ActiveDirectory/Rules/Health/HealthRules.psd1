@{
    Version = '1.0'
    SourceCategory = 'Provider-defined operational threshold'
    Categories = @(
        @{ Id='directory'; Name='Directory Services'; Icon='ResourceServer'; Weight=1.5 }
        @{ Id='replication'; Name='Replication'; Icon='Relationship'; Weight=1.5 }
        @{ Id='sysvol'; Name='SYSVOL / DFSR'; Icon='Document'; Weight=1.4 }
        @{ Id='dns'; Name='DNS'; Icon='Relationship'; Weight=1.1 }
        @{ Id='time'; Name='Time'; Icon='Document'; Weight=1.0 }
        @{ Id='services'; Name='Services'; Icon='ResourceServer'; Weight=1.0 }
        @{ Id='capacity'; Name='Capacity'; Icon='ResourceServer'; Weight=1.0 }
        @{ Id='topology'; Name='Topology'; Icon='Relationship'; Weight=0.8 }
        @{ Id='events'; Name='Events'; Icon='Document'; Weight=0.8 }
        @{ Id='backup'; Name='Backup'; Icon='Document'; Weight=1.0 }
        @{ Id='connectivity'; Name='Connectivity'; Icon='Relationship'; Weight=1.0 }
    )
    Rules = @(
        @{ Id='ad-role'; Title='AD DS role observed'; Category='directory'; Scope='DC'; EvidenceRequirements=@('WindowsFeatures'); Evaluation='ADRole'; Weight=1.0; Critical=$false; Recommendation='Confirm the AD DS role on the controller using supported inventory tooling.'; Validation='Get-WindowsFeature AD-Domain-Services' }
        @{ Id='reachability'; Title='DC reachability'; Category='directory'; Scope='DC'; EvidenceRequirements=@('Reachability'); Evaluation='Reachability'; Weight=1.5; Critical=$true; Recommendation='Validate directory reachability and the remote query path.'; Validation='Test the DC from an authorized management host.' }
        @{ Id='ntds'; Title='NTDS service'; Category='directory'; Scope='DC'; EvidenceRequirements=@('Service:NTDS'); Evaluation='Service'; Weight=1.5; Critical=$true; Recommendation='Inspect NTDS service state and dependent events before remediation.'; Validation='Get-Service NTDS' }
        @{ Id='netlogon'; Title='Netlogon service'; Category='directory'; Scope='DC'; EvidenceRequirements=@('Service:Netlogon'); Evaluation='Service'; Weight=1.3; Critical=$true; Recommendation='Inspect Netlogon service state and registration.'; Validation='Get-Service Netlogon' }
        @{ Id='kdc'; Title='KDC service'; Category='directory'; Scope='DC'; EvidenceRequirements=@('Service:KDC'); Evaluation='Service'; Weight=1.3; Critical=$true; Recommendation='Inspect KDC service state and related events.'; Validation='Get-Service KDC' }
        @{ Id='replication'; Title='Inbound replication'; Category='replication'; Scope='DC'; EvidenceRequirements=@('ReplicationQuery:Partners','ReplicationQuery:Failures','Replication'); Evaluation='Replication'; Weight=1.5; Critical=$true; Recommendation='Review failing inbound partners and naming contexts; validate with repadmin /showrepl.'; Validation='repadmin /showrepl' }
        @{ Id='sysvol-share'; Title='SYSVOL share'; Category='sysvol'; Scope='DC'; EvidenceRequirements=@('Share:SYSVOL'); Evaluation='Share'; Weight=1.3; Critical=$true; Recommendation='Confirm SYSVOL publication and inspect DFSR events.'; Validation='Get-SmbShare -Name SYSVOL' }
        @{ Id='netlogon-share'; Title='NETLOGON share'; Category='sysvol'; Scope='DC'; EvidenceRequirements=@('Share:NETLOGON'); Evaluation='Share'; Weight=1.2; Critical=$true; Recommendation='Confirm NETLOGON publication and dependent services.'; Validation='Get-SmbShare -Name NETLOGON' }
        @{ Id='dfsr-service'; Title='DFSR service'; Category='sysvol'; Scope='DC'; EvidenceRequirements=@('Service:DFSR'); Evaluation='Service'; Weight=1.0; Critical=$false; Recommendation='Inspect DFSR service and event evidence.'; Validation='Get-Service DFSR' }
        @{ Id='dfsr-migration'; Title='DFSR migration state'; Category='sysvol'; Scope='Domain'; EvidenceRequirements=@('DFSRMigration'); Evaluation='DFSRMigration'; Weight=0.8; Critical=$false; Recommendation='Review the observed SYSVOL migration state; do not infer folder health.'; Validation='Confirm migration state with directory tooling.' }
        @{ Id='dfsr-folder'; Title='DFSR replicated-folder state'; Category='sysvol'; Scope='DC'; EvidenceRequirements=@('DFSRFolder'); Evaluation='Unavailable'; Weight=0.7; RequiredForDC=$false; Critical=$false; Recommendation='Collect reliable replicated-folder state before concluding DFSR Health.'; Validation='Inspect replicated-folder state using approved DFSR tooling.' }
        @{ Id='dns-service'; Title='DNS service'; Category='dns'; Scope='DC'; EvidenceRequirements=@('Service:DNS'); Evaluation='Service'; Weight=1.0; Critical=$false; Recommendation='Inspect DNS service only on DCs where DNS is installed.'; Validation='Get-Service DNS' }
        @{ Id='dns-client'; Title='DNS client resolvers'; Category='dns'; Scope='DC'; EvidenceRequirements=@('DNSClient'); Evaluation='DNSClient'; Weight=1.0; Critical=$false; Recommendation='Confirm configured resolver addresses and their reachability.'; Validation='Get-DnsClientServerAddress' }
        @{ Id='dns-zones'; Title='DNS zone evidence'; Category='dns'; Scope='DC'; EvidenceRequirements=@('DNSZones'); Evaluation='DNSZones'; Weight=1.0; Critical=$false; Recommendation='Inspect observed AD-integrated and reverse zone state.'; Validation='Get-DnsServerZone' }
        @{ Id='dns-forwarders'; Title='DNS forwarder evidence'; Category='dns'; Scope='DC'; EvidenceRequirements=@('DNSForwarders'); Evaluation='DNSForwarders'; Weight=0.7; Critical=$false; Recommendation='Review configured forwarders if this DC is expected to forward queries.'; Validation='Get-DnsServerForwarder' }
        @{ Id='resolver-reachability'; Title='Resolver reachability'; Category='dns'; Scope='DC'; EvidenceRequirements=@('ResolverReachability'); Evaluation='Probe'; Weight=0.8; Critical=$false; Recommendation='Run an independent resolver probe.'; Validation='Resolve-DnsName using the configured resolver.' }
        @{ Id='forwarder-reachability'; Title='Forwarder reachability'; Category='dns'; Scope='Domain'; EvidenceRequirements=@('ForwarderReachability'); Evaluation='Probe'; Weight=0.6; Critical=$false; Recommendation='Review failed tested DNS forwarders; untested forwarders remain unverified.'; Validation='Probe the configured forwarder from the relevant DC.' }
        @{ Id='time-source'; Title='Time source observed'; Category='time'; Scope='DC'; EvidenceRequirements=@('TimeSource'); Evaluation='TimeSource'; Weight=0.8; Critical=$false; Recommendation='Inspect W32Time source and role-specific configuration.'; Validation='w32tm /query /status' }
        @{ Id='pdc-source'; Title='PDC time source configuration'; Category='time'; Scope='DC'; EvidenceRequirements=@('TimeSource'); Evaluation='PDCSource'; Weight=0.8; Critical=$false; Recommendation='Confirm configured PDC source against approved time design.'; Validation='w32tm /query /configuration' }
        @{ Id='w32time-service'; Title='W32Time service'; Category='services'; Scope='DC'; EvidenceRequirements=@('Service:W32Time'); Evaluation='Service'; Weight=0.7; Critical=$false; Recommendation='Inspect Windows Time service and event evidence.'; Validation='Get-Service W32Time' }
        @{ Id='time-reachability'; Title='Time source reachability'; Category='time'; Scope='DC'; EvidenceRequirements=@('TimeSourceReachability'); Evaluation='Probe'; Weight=0.8; Critical=$false; Recommendation='Probe the configured time source independently.'; Validation='Confirm NTP reachability without changing configuration.' }
        @{ Id='time-offset'; Title='Time offset'; Category='time'; Scope='DC'; EvidenceRequirements=@('TimeSource'); Evaluation='TimeOffset'; Weight=0.8; Critical=$false; Recommendation='Collect a reliable measured time offset.'; Validation='w32tm /stripchart' }
        @{ Id='disk'; Title='System drive free space'; Category='capacity'; Scope='DC'; EvidenceRequirements=@('Disk'); Evaluation='Disk'; Weight=1.2; Critical=$true; Recommendation='Review capacity, cleanup options, or extend the system drive under change control.'; Validation='Get-Volume' }
        @{ Id='memory'; Title='Memory utilization'; Category='capacity'; Scope='DC'; EvidenceRequirements=@('Memory'); Evaluation='Memory'; Weight=0.7; Critical=$false; Recommendation='Correlate high point-in-time memory with sustained monitoring.'; Validation='Review memory trend before action.' }
        @{ Id='cpu'; Title='CPU utilization'; Category='capacity'; Scope='DC'; EvidenceRequirements=@('CPU'); Evaluation='CPU'; Weight=0.7; Critical=$false; Recommendation='Correlate high point-in-time CPU with sustained monitoring.'; Validation='Review CPU trend before action.' }
        @{ Id='uptime'; Title='Uptime context'; Category='capacity'; Scope='DC'; EvidenceRequirements=@('Uptime'); Evaluation='Uptime'; Weight=0.4; Critical=$false; Recommendation='Review maintenance history and planned reboot policy.'; Validation='Confirm last boot and maintenance history.' }
        @{ Id='site'; Title='DC site membership'; Category='topology'; Scope='DC'; EvidenceRequirements=@('SiteMembership'); Evaluation='Site'; Weight=0.8; Critical=$false; Recommendation='Confirm site assignment and subnet mapping.'; Validation='Get-ADDomainController -Identity <DC>' }
        @{ Id='unmapped-subnets'; Title='Unmapped subnets'; Category='topology'; Scope='Domain'; EvidenceRequirements=@('UnmappedSubnets'); Evaluation='UnmappedSubnets'; Weight=0.8; Critical=$false; Recommendation='Review observed subnets without site mapping.'; Validation='Get-ADReplicationSubnet -Filter *' }
        @{ Id='site-links'; Title='Site link collection'; Category='topology'; Scope='Domain'; EvidenceRequirements=@('SiteLinks'); Evaluation='SiteLinks'; Weight=0.5; Critical=$false; Recommendation='Review site links after a successful query; zero results are not a query failure.'; Validation='Get-ADReplicationSiteLink -Filter *' }
        @{ Id='events'; Title='Selected operational events'; Category='events'; Scope='DC'; EvidenceRequirements=@('EventQuery','Event'); Evaluation='Events'; Weight=0.9; Critical=$false; Recommendation='Review matching severe operational events within the bounded query window.'; Validation='Inspect the recorded event log and provider.' }
        @{ Id='backup'; Title='System-state backup recency'; Category='backup'; Scope='DC'; EvidenceRequirements=@('Backup'); Evaluation='Backup'; Weight=1.1; Critical=$true; Recommendation='Validate the supplied backup provider record and investigate overdue backups.'; Validation='Confirm last successful system-state backup with the backup owner.' }
        @{ Id='ports'; Title='Observed connectivity'; Category='connectivity'; Scope='DC'; EvidenceRequirements=@('Port'); Evaluation='Ports'; Weight=0.8; Critical=$false; Recommendation='Investigate failed tested ports from the recorded source; untested ports remain unverified.'; Validation='Repeat scoped connection test from the same source.' }
        @{ Id='pending-reboot'; Title='Pending reboot'; Category='services'; Scope='DC'; EvidenceRequirements=@('PendingReboot'); Evaluation='PendingReboot'; Weight=0.5; Critical=$false; Recommendation='Review reboot requirement and schedule maintenance.'; Validation='Verify pending reboot using an approved method.' }
    )
}
